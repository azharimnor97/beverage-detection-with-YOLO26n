*.jpeg

# Ignore all images inside the data/ folder
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
data/**/*.tiff
data/**/*.webp

# ── Archive Files ─────────────────────────────────────────────────────────────
# Ignore ZIP archives
*.zip

# ── Video Files ───────────────────────────────────────────────────────────────
# Ignore AVI video files
*.avi

# ── Python ────────────────────────────────────────────────────────────────────
# Byte-compiled / optimized / DLL files
